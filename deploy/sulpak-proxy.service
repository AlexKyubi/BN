[Unit]
Description=Sulpak stock proxy (BN)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/bn-proxy
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=ALLOWED_ORIGINS=https://bn.alexkyubi.com
ExecStart=/usr/bin/python3 /opt/bn-proxy/proxy_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bn-proxy

[Install]
WantedBy=multi-user.target
